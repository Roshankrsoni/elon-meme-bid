# Copy to `.env` and fill in. The page runs without these — only bidding
# and payment are disabled until they are set.
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Edge-function secrets (Supabase dashboard → Edge Functions → Secrets, or
# `supabase secrets set`). Never prefix these with VITE_ — they stay server-side.
# DODO_API_KEY=<dodo-payments-api-key>
# DODO_ENV=test            # test | live
# DODO_WEBHOOK_SECRET=<signing-secret-from-the-webhook-endpoint-overview-tab>
